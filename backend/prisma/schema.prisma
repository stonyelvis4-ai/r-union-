generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  role         Role     @default(PARTICIPANT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  managerId    String?  @map("manager_id")

  meetingsOwned Meeting[]     @relation("MeetingOwner")
  attendances   Attendance[] @relation("AttendanceUser")
  manager       User?        @relation("AdminParticipants", fields: [managerId], references: [id], onDelete: SetNull)
  participantsManaged User[] @relation("AdminParticipants")

  @@index([managerId])
}

model Training {
  id              String              @id @default(cuid())
  title           String
  description     String?             @db.Text
  mode            TrainingMode
  date            DateTime            @db.Date
  time            String
  trainer         String?
  location        String?
  onlineUrl       String?             @map("online_url")
  status          TrainingStatus      @default(DRAFT)
  qrToken         String              @unique @map("qr_token")
  qrActive        Boolean             @default(true) @map("qr_active")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  presentationItems TrainingPresentationItem[]
  registrations     TrainingRegistration[]
}

model TrainingPresentationItem {
  id              String   @id @default(cuid())
  trainingId      String   @map("training_id")
  title           String
  description     String?  @db.Text
  durationMinutes Int?     @map("duration_minutes")
  resourceUrl     String?  @map("resource_url")
  position        Int
  createdAt       DateTime @default(now()) @map("created_at")

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, position])
}

model TrainingRegistration {
  id           String   @id @default(cuid())
  trainingId   String   @map("training_id")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String
  phone        String
  cityCountry  String?  @map("city_country")
  organization String?
  jobTitle     String?  @map("job_title")
  timezone     String?
  signature    String   @db.Text
  signedAt     DateTime @default(now()) @map("signed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, email])
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  date      DateTime @db.Date
  time      String   // "HH:mm" or store as DateTime if preferred
  location  String?
  agenda    String?  @db.Text
  status    MeetingStatus @default(DRAFT)
  ownerId   String   @map("owner_id")
  qrToken   String   @unique @map("qr_token")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner        User         @relation("MeetingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participants Participant[]
  attendances  Attendance[]
  recordings   AudioRecording[]
  transcription Transcription?
  summary       Summary?
}

model AudioRecording {
  id              String   @id @default(cuid())
  meetingId       String   @map("meeting_id")
  storageKey      String   @map("storage_key")
  storageUrl      String?  @map("storage_url")
  durationSeconds Int?     @map("duration_seconds")
  status          String   @default("uploading")
  createdAt       DateTime @default(now()) @map("created_at")

  meeting       Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  transcription Transcription?
}

model Transcription {
  id           String   @id @default(cuid())
  meetingId    String   @unique @map("meeting_id")
  recordingId  String?  @unique @map("recording_id")
  fullText     String?  @map("full_text") @db.Text
  status       String   @default("pending")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  meeting   Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  recording AudioRecording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
}

model Summary {
  id                 String   @id @default(cuid())
  meetingId          String   @unique @map("meeting_id")
  title              String
  meetingDate        DateTime @map("meeting_date") @db.Date
  participantsText   String   @map("participants_text") @db.Text
  discussionSummary  String   @map("discussion_summary") @db.Text
  keyDecisions       String   @map("key_decisions") @db.Text
  actionItems        String   @map("action_items") @db.Text
  responsiblePersons String   @map("responsible_persons") @db.Text
  nextSteps         String   @map("next_steps") @db.Text
  generatedAt       DateTime @default(now()) @map("generated_at")
  version           Int      @default(1)
  isSharedWithParticipants Boolean @default(false) @map("is_shared_with_participants")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model Participant {
  id          String   @id @default(cuid())
  meetingId   String   @map("meeting_id")
  email       String
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, email])
}

model Attendance {
  id           String   @id @default(cuid())
  meetingId    String   @map("meeting_id")
  scannedAt    DateTime @default(now()) @map("scanned_at")
  userId       String?  @map("user_id")
  attendeeName String?  @map("attendee_name")
  attendeeEmail String? @map("attendee_email")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?   @relation("AttendanceUser", fields: [userId], references: [id], onDelete: SetNull)
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum Role {
  ADMIN
  PARTICIPANT
  ORGANIZER
}

enum TrainingMode {
  PRESENTIAL
  ONLINE
}

enum TrainingStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}
