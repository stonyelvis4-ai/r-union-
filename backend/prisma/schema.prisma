generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  role         Role     @default(PARTICIPANT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  meetingsOwned Meeting[]     @relation("MeetingOwner")
  attendances   Attendance[] @relation("AttendanceUser")
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  date      DateTime @db.Date
  time      String   // "HH:mm" or store as DateTime if preferred
  location  String?
  agenda    String?  @db.Text
  status    MeetingStatus @default(DRAFT)
  ownerId   String   @map("owner_id")
  qrToken   String   @unique @map("qr_token")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner        User         @relation("MeetingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participants Participant[]
  attendances  Attendance[]
  recordings   AudioRecording[]
  transcription Transcription?
  summary       Summary?
}

model AudioRecording {
  id              String   @id @default(cuid())
  meetingId       String   @map("meeting_id")
  storageKey      String   @map("storage_key")
  storageUrl      String?  @map("storage_url")
  durationSeconds Int?     @map("duration_seconds")
  status          String   @default("uploading")
  createdAt       DateTime @default(now()) @map("created_at")

  meeting       Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  transcription Transcription?
}

model Transcription {
  id           String   @id @default(cuid())
  meetingId    String   @unique @map("meeting_id")
  recordingId  String?  @unique @map("recording_id")
  fullText     String?  @map("full_text") @db.Text
  status       String   @default("pending")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  meeting   Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  recording AudioRecording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
}

model Summary {
  id                 String   @id @default(cuid())
  meetingId          String   @unique @map("meeting_id")
  title              String
  meetingDate        DateTime @map("meeting_date") @db.Date
  participantsText   String   @map("participants_text") @db.Text
  discussionSummary  String   @map("discussion_summary") @db.Text
  keyDecisions       String   @map("key_decisions") @db.Text
  actionItems        String   @map("action_items") @db.Text
  responsiblePersons String   @map("responsible_persons") @db.Text
  nextSteps         String   @map("next_steps") @db.Text
  generatedAt       DateTime @default(now()) @map("generated_at")
  version           Int      @default(1)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model Participant {
  id          String   @id @default(cuid())
  meetingId   String   @map("meeting_id")
  email       String
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, email])
}

model Attendance {
  id           String   @id @default(cuid())
  meetingId    String   @map("meeting_id")
  scannedAt    DateTime @default(now()) @map("scanned_at")
  userId       String?  @map("user_id")
  attendeeName String?  @map("attendee_name")
  attendeeEmail String? @map("attendee_email")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?   @relation("AttendanceUser", fields: [userId], references: [id], onDelete: SetNull)
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum Role {
  ADMIN
  PARTICIPANT
}
