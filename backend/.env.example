# Backend environment variables
# Copy this file to .env and fill in the values (do not commit .env)

NODE_ENV=development
PORT=4000

# PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example for local SMARTREUNION database:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/SMARTREUNION
DATABASE_URL=

# JWT secret for auth tokens (generate a random string)
JWT_SECRET=

# Supabase Auth (required for Google sign-in)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: allow frontend origin (default *)
# FRONTEND_URL=http://localhost:3000

# SMTP Configuration for sending emails (nodemailer)
# Example with Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-app-password
#   SMTP_FROM=SmartReunion <your-email@gmail.com>
#
# Example with Mailtrap (dev/test):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=your-mailtrap-user
#   SMTP_PASS=your-mailtrap-pass
#
# If SMTP_HOST is not set, emails are logged to console only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
